name: ChatGPT Integration Workflow

on:
  workflow_dispatch:
  pull_request:
    types: [opened, synchronize]
  issues:
    types: [opened]

jobs:
  chatgpt-request:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install OpenAI Python library
        run: pip install openai

      - name: Call ChatGPT API
        id: chatgpt
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: |
          python - <<'EOF'
          import os
          from openai import OpenAI
          
          api_key = os.getenv('OPENAI_API_KEY')
          if not api_key:
              print("::error::OPENAI_API_KEY secret is not set")
              exit(1)
          
          client = OpenAI(api_key=api_key)
          
          try:
              response = client.chat.completions.create(
                  model="gpt-4",
                  messages=[
                      {"role": "system", "content": "You are a helpful assistant for code review and analysis."},
                      {"role": "user", "content": "Analyze this code and provide feedback."}
                  ],
                  max_tokens=150
              )
              
              result = response.choices[0].message.content
              with open('chatgpt_response.txt', 'w') as f:
                  f.write(result)
              
          except Exception as e:
              print(f"::error::Failed to call ChatGPT API: {str(e)}")
              exit(1)
          EOF

      - name: Add comment to PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const response = fs.readFileSync('chatgpt_response.txt', 'utf8');
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `## 🤖 ChatGPT Analysis\n\n${response}`
            });
